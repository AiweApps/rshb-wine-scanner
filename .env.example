# Asset pack written by tools/export_web_assets.py (outside this repository), mounted read-only at /assets.
WINE_SCANNER_ASSETS_HOST_DIR=/absolute/path/to/rshb-wine-scanner-assets/web
# manifest_sha256 printed by the exporter.
WINE_SCANNER_ASSETS_SHA256=
# Profile checksum the recognition API must report on /health/ready and in every answer.
WINE_SCANNER_EXPECTED_PROFILE=
# Recognition API as seen from the container; outside Docker the default is http://127.0.0.1:8175.
WINE_SCANNER_BACKEND=http://host.docker.internal:8175
# Host port published on 127.0.0.1.
WINE_SCANNER_PUBLISH_PORT=8287
